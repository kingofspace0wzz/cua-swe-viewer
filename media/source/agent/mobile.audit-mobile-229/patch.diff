 const defaultSettings = ALIPAY_CONFIG.settings as AlipaySettings;
+
+// ── Bank identity helpers ─────────────────────────────────────────
+
+type BankCardWithLegacyIdentity = AlipayBankCard & { bankCode?: unknown };
+
+const GENERIC_BANK_NAMES = new Set(['卡', '银行卡', '储蓄卡', '借记卡', '信用卡', '银行']);
+const LEGACY_BANK_CODE_ALIASES: Record<string, string> = {
+  bcm: 'bocom',
+};
+
+function normalizeBankCode(value: unknown): string {
+  const code = String(value ?? '').trim().toLowerCase().replace(/[^a-z0-9]/g, '');
+  if (!code || code === 'card') return '';
+  return LEGACY_BANK_CODE_ALIASES[code] || code;
+}
+
+function getBankNameAliases(value: unknown): Set<string> {
+  const normalized = String(value ?? '')
+    .normalize('NFKC')
+    .toLowerCase()
+    .replace(/股份有限公司|有限责任公司|有限公司/g, '')
+    .replace(/储蓄卡|借记卡|信用卡|贷记卡|银行卡/g, '')
+    .replace(/[\s·•\-—_（）()]/g, '');
+  const aliases = new Set<string>();
+  const addAlias = (alias: string) => {
+    if (alias && !GENERIC_BANK_NAMES.has(alias)) aliases.add(alias);
+  };
+
+  addAlias(normalized);
+  if (normalized.startsWith('中国')) addAlias(normalized.slice(2));
+  for (const alias of [...aliases]) {
+    if (alias.includes('邮政储蓄')) addAlias(alias.replace('邮政储蓄', '邮储'));
+  }
+  return aliases;
+}
+
+const BANK_CATALOG = BANK_OPTIONS.map(option => ({
+  code: normalizeBankCode(option.id),
+  nameAliases: getBankNameAliases(option.bankName),
+}));
+const KNOWN_BANK_CODES = new Set(BANK_CATALOG.map(bank => bank.code));
+
+function setsOverlap(left: Set<string>, right: Set<string>): boolean {
+  for (const value of left) {
+    if (right.has(value)) return true;
+  }
+  return false;
+}
+
+function findCatalogBankCode(nameAliases: Set<string>): string {
+  return BANK_CATALOG.find(bank => setsOverlap(bank.nameAliases, nameAliases))?.code || '';
+}
+
+function getCardIdBankCode(cardId: unknown): string {
+  const match = String(cardId ?? '').trim().toLowerCase().match(/^([a-z][a-z0-9]*?)(?=[_-]|\d)/);
+  const code = normalizeBankCode(match?.[1]);
+  return KNOWN_BANK_CODES.has(code) ? code : '';
+}
+
+function getBankIdentity(bankName: unknown, bankCode?: unknown, cardId?: unknown) {
+  const nameAliases = getBankNameAliases(bankName);
+  const codes = new Set<string>();
+  const addCode = (value: unknown) => {
+    const code = normalizeBankCode(value);
+    if (code) codes.add(code);
+  };
+
+  addCode(bankCode);
+  addCode(getCardIdBankCode(cardId));
+  if (codes.size === 0) addCode(findCatalogBankCode(nameAliases));
+  return { codes, nameAliases };
+}
+
+function isSameBank(
+  target: ReturnType<typeof getBankIdentity>,
+  card: BankCardWithLegacyIdentity,
+): boolean {
+  const candidate = getBankIdentity(card.bankName, card.bankCode, card.id);
+  if (target.codes.size > 0 && candidate.codes.size > 0) {
+    return setsOverlap(target.codes, candidate.codes);
+  }
+  return setsOverlap(target.nameAliases, candidate.nameAliases);
+}
 
