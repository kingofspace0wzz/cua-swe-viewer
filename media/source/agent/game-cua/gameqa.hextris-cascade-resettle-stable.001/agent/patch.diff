+function queueConsolidation(block) {
+	if (!MainHex.pendingConsolidations) MainHex.pendingConsolidations = [];
+	if (!block || block.deleted !== 0 || MainHex.pendingConsolidations.indexOf(block) !== -1) return;
+	MainHex.pendingConsolidations.push(block);
+}
+
+function hasMovingColor(color) {
+	for (var side = 0; side < MainHex.blocks.length; side++) {
+		for (var index = 0; index < MainHex.blocks[side].length; index++) {
+			var block = MainHex.blocks[side][index];
+			if (block.color === color && block.deleted === 0 && block.settled !== 1) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+function releasePendingConsolidations() {
+	if (!MainHex.pendingConsolidations) MainHex.pendingConsolidations = [];
+	for (var i = 0; i < MainHex.pendingConsolidations.length;) {
+		var block = MainHex.pendingConsolidations[i];
+
+		if (block.deleted !== 0) {
+			MainHex.pendingConsolidations.splice(i, 1);
+			continue;
+		}
+
+		if (hasMovingColor(block.color)) {
+			i++;
+			continue;
+		}
+
+		var index = block.getIndex();
+		MainHex.pendingConsolidations.splice(i, 1);
+		if (index !== undefined) {
+			consolidateBlocks(MainHex, block.attachedLane, index);
+		}
+	}
+}
