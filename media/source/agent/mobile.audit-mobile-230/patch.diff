+function getSeatPositionColumns(seatType: string): Set<string> | null {
+  if (!supportsPositionPick(seatType)) return null;
+  if (seatType.includes('商务')) return new Set(['A', 'C', 'F']);
+  if (seatType.includes('一等')) return new Set(['A', 'C', 'D', 'F']);
+  return new Set(['A', 'B', 'C', 'D', 'F']);
+}
+
+function retainCompatibleSeatPositions(
+  preferences: SeatPositionsByPassengerId,
+  seatType: string,
+): SeatPositionsByPassengerId {
+  const columns = getSeatPositionColumns(seatType);
+  if (!columns) return {};
+
+  return Object.fromEntries(
+    Object.entries(preferences).filter(([, position]) => {
+      const [rawRow, column] = position.split('-');
+      const row = Number.parseInt(rawRow ?? '', 10);
+      return Number.isInteger(row) && row >= 0 && !!column && columns.has(column);
+    }),
+  );
+}
+
+function formatSeatPosition(position: string): string {
+  const [rawRow, column] = position.split('-');
+  const row = Number.parseInt(rawRow ?? '', 10);
+  return `${Number.isInteger(row) ? row + 1 : rawRow}排${column}座`;
 }
 
